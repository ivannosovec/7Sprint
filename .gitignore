# Создать .gitignore с базовым содержимым
@"
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Virtual environment
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Allure reports


# Logs
*.log

# Project specific
.DS_Store
Thumbs.db
"@ | Out-File -FilePath .gitignore -Encoding UTF8